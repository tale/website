---
import type { CollectionEntry } from "astro:content";
import Link from "@/components/link.astro";
import Logo from "@/components/logo.astro";

interface Props {
  credential: CollectionEntry<"credentials">["data"];
}

const { credential } = Astro.props;
const { id, role, org, abbr, tint, link } = credential;
const isExperience = id.startsWith("exp:");
const logo = id.slice(id.indexOf(":") + 1);
---

<span
  class:list={["flex gap-2", isExperience ? "items-start" : "items-center"]}
>
  <Logo
    name={logo}
    width={20}
    height={20}
    style={`background-color: ${tint}`}
    class="inline-block shrink-0"
  />
  {isExperience ? (
    <span>
      {role} @{" "}
      {link ? (
        <Link external to={link}>
          {org}
        </Link>
      ) : (
        org
      )}
    </span>
  ) : abbr ? (
    <>
      <span class="hidden sm:inline">{org}</span>
      <span class="sm:hidden">{abbr}</span>
    </>
  ) : (
    <span>{org}</span>
  )}
</span>

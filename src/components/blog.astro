---
import { getCollection } from "astro:content";
import Section from "@/components/section.astro";

const posts = await getCollection("blog");
const sortedPosts = posts.toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime());
const years = Map.groupBy(sortedPosts, (post) => post.data.date.getUTCFullYear());
---

<Section title="Writing" />
<div class="space-y-3">
  {[...years].map(([year, yearPosts]) => (
    <section class="flex gap-6">
      <h3 class="text-faint">{year}</h3>
      <ul class="space-y-1">
        {yearPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="hover:underline">
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

---
import ascii from "@/assets/ascii.txt?raw";
const [mountain, base] = ascii.split("\n\n");
---

<div
  class:list={[
    "flex flex-col items-center leading-tight select-none",
    "text-[0.4rem] xs:text-[0.6rem] sm:text-xs",
  ]}
>
  <pre class="text-faint">{mountain}</pre>
  <pre class="text-muted">{base}</pre>
</div>

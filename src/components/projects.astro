---
import { getCollection } from "astro:content";
import IconButton from "@/components/icon-button.astro";
import Link from "@/components/link.astro";
import Section from "@/components/section.astro";
import Table from "@/components/table.astro";

const projects = (await getCollection("projects")).map(({ data }) => data);
---

<Section title="Projects" meta={`[${projects.length} entries]`} />
<div class="overflow-x-auto" role="region" aria-label="Projects" tabindex="0">
  <Table
    class="min-w-xl"
    columns={[
      {
        key: "name",
        heading: "Project",
        class: "whitespace-nowrap",
        render: (project) =>
          project.link ? (
            <Link external to={project.link}>
              {project.name}
            </Link>
          ) : (
            project.name
          ),
      },
      { key: "description", heading: "Description", class: "opacity-80" },
      {
        key: "icons",
        heading: "Stack",
        class: "whitespace-nowrap",
        render: (project) => (
          <span class="flex shrink-0 gap-1">
            {project.icons.map((icon) => (
              <IconButton name={icon} />
            ))}
          </span>
        ),
      },
    ]}
    rows={projects}
  />
</div>

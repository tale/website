---
import { getCollection } from "astro:content";
import Section from "@/components/section.astro";

const users = await getCollection("sponsorUsers");
const orgs = await getCollection("sponsorOrganizations");
const [totalBreakdown] = await getCollection("sponsorTotal");

if (totalBreakdown == null) {
  throw new Error("Missing sponsor total breakdown data");
}

const { total } = totalBreakdown.data;
const active = users.length + orgs.length;

const groups = [
  { title: "Organizations", sponsors: orgs },
  { title: "Individuals", sponsors: users },
].filter(({ sponsors }) => sponsors.length > 0);
---

<Section title="Sponsors" meta={`${active} active, ${total} all-time`} />
<p class="mb-3 text-muted">
  Thank you to everyone who has ever supported my work — past and present.
</p>

{groups.map(({ title, sponsors }) => (
  <>
    <Section level={3} {title} class="mt-4" />
    <div class="grid sm:grid-cols-[repeat(auto-fill,minmax(14rem,1fr))] sm:gap-2">
      {sponsors.map(({ data }) => (
        <a
          href={data.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "flex items-center border border-line hover:bg-raised",
            "not-first:border-t-0 sm:not-first:border-t",
          ]}
        >
          <span class="border-r border-line px-2 py-1">
            <img
              src={data.avatar}
              alt={data.name}
              width="24"
              height="24"
              class="rounded-full"
              loading="lazy"
            />
          </span>
          <span class="px-2 py-1">{data.name}</span>
        </a>
      ))}
    </div>
  </>
))}

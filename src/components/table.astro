---
export type Column<Row> = {
  heading: string;
  align?: "left" | "right";
  width?: string;
  class?: string;
  render: (row: Row) => unknown;
};

interface Props<Row> {
  columns: readonly Column<NoInfer<Row>>[];
  rows: readonly Row[];
  class?: string;
}

const { columns, rows, class: extra } = Astro.props;
const alignment = { left: "text-left", right: "text-right" };
---

<table class:list={["w-full border-collapse border border-line", extra]}>
  <colgroup>
    {columns.map((column) => (
      <col class={column.width} />
    ))}
  </colgroup>
  <thead>
    <tr class="border-b border-line text-faint">
      {columns.map((column) => (
        <th
          scope="col"
          class:list={[
            "border-r border-line px-2 py-1 font-bold last:border-r-0",
            alignment[column.align ?? "left"],
          ]}
        >
          {column.heading}
        </th>
      ))}
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr class="border-b border-line last:border-b-0 hover:bg-raised">
        {columns.map((column) => (
          <td
            class:list={[
              "border-r border-line px-2 py-1 align-top last:border-r-0",
              alignment[column.align ?? "left"],
              column.class,
            ]}
          >
            {column.render(row)}
          </td>
        ))}
      </tr>
    ))}
  </tbody>
</table>

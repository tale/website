---
import { getCollection, type CollectionEntry } from "astro:content";
import Experience from "@/components/experience.astro";
import Credential from "@/components/credential.astro";
import Section from "@/components/section.astro";
import Table from "@/components/table.astro";

type Range = CollectionEntry<"credentials">["data"]["range"];

const startYear = (range: Range) => (Array.isArray(range) ? range[0] : range);

function formatRange(range: Range) {
  if (!Array.isArray(range)) return range;

  const [start, end] = range;
  return `${start} -> ${end === -1 ? "...." : end}`;
}

const credentials = (await getCollection("credentials"))
  .map(({ data }) => data)
  .toSorted((a, b) => startYear(b.range) - startYear(a.range));

const experiences = credentials
  .filter(({ id }) => id.startsWith("exp:"))
  .map((credential) => ({
    ...credential,
    previousRoles: (credential.previousRoles ?? []).toSorted(
      (a, b) => startYear(b.range) - startYear(a.range),
    ),
  }));
const educations = credentials.filter(({ id }) => id.startsWith("edu:"));
---

<Section title="Experience" meta={`[${experiences.length} entries]`} />
<div class="overflow-x-auto" role="region" aria-label="Experience" tabindex="0">
  <Table
    rows={experiences}
    columns={[
      {
        heading: "Role",
        class: "whitespace-nowrap",
        render: (credential) => <Experience {credential} />,
      },
      {
        heading: "Tenure",
        align: "right",
        width: "w-[14ch]",
        class: "whitespace-nowrap tabular-nums",
        render: ({ range, previousRoles }) => (
          <div class="opacity-50">
            <div class="min-h-5">{formatRange(range)}</div>
            {previousRoles.length > 0 && (
              <ul class="mt-1 space-y-1">
                {previousRoles.map(({ range }) => (
                  <li>{formatRange(range)}</li>
                ))}
              </ul>
            )}
          </div>
        ),
      },
    ]}
  />
</div>

<Section
  title="Education"
  class="mt-6"
  meta={`[${educations.length} entries]`}
/>
<Table
  rows={educations}
  columns={[
    {
      heading: "Institution",
      render: (credential) => <Credential {credential} />,
    },
    {
      key: "role",
      heading: "Degree",
      align: "right",
      width: "w-[14ch]",
      class: "opacity-50 whitespace-nowrap tabular-nums",
    },
  ]}
/>

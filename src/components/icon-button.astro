---
import { getIconData, iconToHTML, iconToSVG, replaceIDs } from "@iconify/utils";
import { icons } from "@iconify-json/devicon";

const names = {
  "go-wordmark": "Go",
  kubernetes: "Kubernetes",
  lua: "Lua",
  react: "React",
  swift: "Swift",
  rust: "Rust",
  typescript: "TypeScript",
  zig: "Zig",
};

interface Props {
  name: string;
}

const { name } = Astro.props;
const label = names[name as keyof typeof names];
if (!label) {
  throw new Error(`Icon "${name}" needs a label in icon-button.astro`);
}

const iconData = getIconData(icons, name);
if (!iconData) {
  throw new Error(`Icon "${name}" not found in @iconify-json/devicon`);
}

const { attributes, body } = iconToSVG(iconData, { width: 20, height: 20 });
const svg = iconToHTML(replaceIDs(body), attributes);
---

<button type="button" aria-label={label} class="group relative flex">
  <Fragment set:html={svg} />
  <span
    class:list={[
      "absolute right-0 bottom-full z-10 mb-2 hidden px-0.5 whitespace-nowrap",
      "bg-ink text-canvas group-hover:block group-focus-visible:block",
    ]}
  >
    {label}
  </span>
</button>

---
import { getIconData, iconToHTML, iconToSVG, replaceIDs } from "@iconify/utils";
import { icons } from "@iconify-json/devicon";

const names = {
  "go-wordmark": "Go",
  kubernetes: "Kubernetes",
  lua: "Lua",
  react: "React",
  swift: "Swift",
  rust: "Rust",
  typescript: "TypeScript",
  zig: "Zig",
};

interface Props {
  name: (string & {}) | keyof typeof names;
  size?: number;
}

const { name, size = 20 } = Astro.props;
const label = names[name as keyof typeof names];
if (!label) {
  throw new Error(`Icon "${name}" needs a label in icon-button.astro`);
}

const iconData = getIconData(icons, name);
if (!iconData) {
  throw new Error(`Icon "${name}" not found in @iconify-json/devicon`);
}

const { attributes, body } = iconToSVG(iconData, { width: size, height: size });
const svg = iconToHTML(replaceIDs(body), attributes);
---

<button
  type="button"
  aria-label={label}
  class="group relative flex shrink-0 items-center justify-center"
>
  <Fragment set:html={svg} />
  <div
    class={`
			hidden absolute right-0 bottom-full group-hover:block group-focus-visible:block z-10 mb-2 px-0.5 whitespace-nowrap
			bg-neutral-700 text-neutral-100 dark:bg-neutral-300 dark:text-neutral-900
	`}
  >
    <p>{label}</p>
  </div>
</button>

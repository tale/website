---
interface Props {
  to: string;
}

const { to } = Astro.props;

// Prettier wraps link labels onto their own lines; trim so that whitespace
// doesn't render as an underlined trailing space inside the link.
const label = (await Astro.slots.render("default")).trim();
---

<a href={to} class="text-accent hover:underline" set:html={label} />

---
import { getCollection, render } from "astro:content";
import Toc from "@/components/toc.astro";
import Site from "@/layouts/site.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const sectionHeadings = headings.filter(({ depth }) => depth <= 3);
const tocHeadings = [{ depth: 2, slug: "main", text: "Introduction" }, ...sectionHeadings];
---

<Site
  title={post.data.title}
  desc={post.data.description}
  date={post.data.date}
  image={`/blog/${post.id}/og.png`}
>
  <article class="relative">
    <header class="mb-8">
      <h1 class="text-xl font-bold text-balance">{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()} class="mt-1 block text-faint">
        {post.data.date.toISOString().slice(0, 10)}
      </time>
    </header>
    {sectionHeadings.length > 0 && <Toc headings={tocHeadings} />}
    <div class="prose">
      <Content />
    </div>
  </article>
</Site>

---
import Credentials from "@/components/credentials.astro";
import Link from "@/components/link.astro";
import Projects from "@/components/projects.astro";
import Site from "@/layouts/site.astro";
import { staticPages } from "@/metadata";

const { title, description: desc } = staticPages.portfolio;
---

<Site {title} {desc}>
	<p class="mb-6">
		A small snippet of my resume and a list of publicly available projects
		that I have worked on. If you are a recruiter looking to get in touch,
		please email me at
		{" "}
		<Link external to="mailto:aarnav@tale.me">[aarnav@tale.me]</Link>.
	</p>

	<div class="mb-6">
		<Credentials />
	</div>
	<Projects />
</Site>

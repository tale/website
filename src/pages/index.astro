---
import Blog from "@/components/blog.astro";
import Link from "@/components/link.astro";
import Site from "@/layouts/site.astro";
import { staticPages } from "@/metadata";

const { title, description: desc } = staticPages.index;
---

<Site {title} {desc}>
  <p class="mb-4">
    Software engineer by day with a passion for solving big-data problems and
    building scalable systems. I also dabble in{" "}
    <Link external to="https://github.com/tale">open-source projects</Link>{" "}
    on the side.
  </p>
  <p class="mb-10">
    When away from the keyboard, I'm rock climbing, skiing, or in the mountains
    chasing the next summit. Feel free to get in touch with me for any reason,
    both professional or personal, at{" "}
    <Link external to="mailto:aarnav@tale.me">aarnav@tale.me</Link>.
  </p>

  <Blog />
</Site>

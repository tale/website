---
import Link from "@/components/link.astro";
import Section from "@/components/section.astro";
import Site from "@/layouts/site.astro";
import Sponsors from "@/components/sponsors.astro";
import { staticPages } from "@/metadata";

const { title, description: desc } = staticPages.sponsor;

const platforms = [
  {
    name: "GitHub Sponsors",
    href: "https://github.com/sponsors/tale",
    note: "Preferred, recurring or one-time tiers.",
  },
  {
    name: "Ko-fi",
    href: "https://ko-fi.com/atale",
    note: "If you can't use GitHub Sponsors.",
  },
];
---

<Site {title} {desc}>
  <p class="mb-10">
    Support my open-source work by sponsoring me on GitHub. I work full-time so
    any support helps me dedicate more time to maintaining my projects. Every
    contribution makes a difference and is greatly appreciated. Thank you for
    considering supporting my work!
  </p>

  <Section title="Where to sponsor" />
  <ul class="mb-10 space-y-1">
    {platforms.map((platform) => (
      <li>
        <Link to={platform.href}>{platform.name}</Link>
        <span class="text-muted"> - {platform.note}</span>
      </li>
    ))}
  </ul>

  <Section title="Where the support goes" />
  <ul class="mb-10 list-disc space-y-1 pl-5 marker:text-faint">
    <li>Hosting and infrastructure for projects like Rootbeer and Headplane.</li>
    <li>Time to triage issues, ship features, and review community PRs.</li>
    <li>The occasional cup of coffee that keeps the late-night commits flowing.</li>
  </ul>

  <Sponsors />
</Site>

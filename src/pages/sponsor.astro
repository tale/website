---
import Link from "@/components/link.astro";
import Section from "@/components/section.astro";
import Table from "@/components/table.astro";
import Site from "@/layouts/site.astro";
import Sponsors from "@/components/sponsors.astro";
import { staticPages } from "@/metadata";

const { title, description: desc } = staticPages.sponsor;

const platforms = [
  {
    name: "GitHub Sponsors",
    href: "https://github.com/sponsors/tale",
    note: "Preferred, recurring or one-time tiers.",
  },
  {
    name: "Ko-fi",
    href: "https://ko-fi.com/atale",
    note: "If you can't use GitHub Sponsors.",
  },
];
---

<Site {title} {desc}>
  <p class="mb-6">
    Support my open-source work by sponsoring me on GitHub. I work full-time so
    any support helps me dedicate more time to maintaining my projects. Every
    contribution makes a difference and is greatly appreciated. Thank you for
    considering supporting my work!
  </p>

  <Section title="Where to Sponsor" meta={`[${platforms.length} entries]`} />
  <Table
    class="mb-6"
    columns={[
      {
        key: "name",
        heading: "Platform",
        width: "sm:w-[22ch]",
        render: (platform) => (
          <Link external wrap to={platform.href}>
            {platform.name}
          </Link>
        ),
      },
      { key: "note", heading: "Notes", class: "opacity-80" },
    ]}
    rows={platforms}
  />

  <Section title="Where the Support Goes" meta={`[3 entries]`} />
  <Table
    class="mb-6"
    columns={[
      {
        heading: "Where the Support Goes",
        class: "opacity-80",
        render: (allocation) => allocation,
      },
    ]}
    rows={[
      "Hosting and infrastructure for projects like Rootbeer and Headplane",
      "Time to triage issues, ship features, and review community PRs.",
      "The occasional cup of coffee that keeps the late-night commits flowing.",
    ]}
  />

  <Sponsors />
</Site>
